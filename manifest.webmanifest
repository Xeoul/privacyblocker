{
  "name": "PrivacyBlocker",
  "short_name": "PrivacyBlocker",
  "description": "Get your personal info off data brokers. Encrypted, local-only.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f9",
